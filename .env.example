# Copy this file to .env and fill in the values.

# Local development: a SQLite file. Online: the hosted PostgreSQL URL.
DATABASE_URL="file:./dev.db"

# A long random string used to sign login sessions. Keep it secret.
SESSION_SECRET="replace-with-a-long-random-string"

# Needed once, to create the manager account at /setup. Keep it secret.
SETUP_KEY="replace-with-a-one-time-setup-key"

# The public web address, used in WhatsApp share links.
APP_URL="http://localhost:3000"
