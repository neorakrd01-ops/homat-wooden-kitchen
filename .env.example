# Copy this file to .env for local use. Online, set these in the hosting dashboard instead.

# Local: a SQLite file. Online: the PostgreSQL address from Neon (starts with postgresql://).
# The Neon integration on Vercel fills DATABASE_URL and DATABASE_URL_UNPOOLED for you.
DATABASE_URL="file:./dev.db"

# A long random string used to sign logins. Keep it secret. Use a NEW one online.
SESSION_SECRET="replace-with-a-long-random-string"

# Needed once, to create the manager account at /setup. Use a NEW one online.
SETUP_KEY="replace-with-a-one-time-setup-key"

# The real web address, used in WhatsApp share links (no slash at the end).
APP_URL="http://localhost:3000"
